{
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git blame *)",
      "Bash(git stash list)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(gh api *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:arduino-pico.readthedocs.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__plugin_luxonis_luxonis"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "mcp__plugin_luxonis_luxonis__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'"
          }
        ]
      }
    ]
  }
}
