#version 460 core

// Measure Sums
// One frame of one side of the depth velocity's measuring, summed on the GPU: per 16 × 16 workgroup the sums the
// row needs over the frame's regions, and over the whole frame the histograms of the still part's values. The
// regions come from the CPU, once a frame for all sides (bits: 1 the core, 2 the edge, 4 the table, 8 the core's
// pixels that move in the loop, 16 the mask). x/y and z are as the fluid gets them, px per frame: the velocity
// over its gains times the frame's time and width.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D velocity;     // x, y, z: image widths per second times the gains
layout(binding = 1) uniform sampler2D estimate;     // the depth velocity's: z (view widths per frame), disparity, rate, anchor
layout(binding = 2) uniform sampler2D before;       // the estimate the frame before
layout(binding = 3) uniform sampler2D z_position;   // its weight in green
layout(binding = 4) uniform sampler2D regions;      // the bits above, over 255 (R8)

layout(std430, binding = 0) writeonly buffer Partials { float uPartials[]; };   // SUMS a workgroup
layout(std430, binding = 1) buffer Histograms { uint uHistograms[]; };          // HISTOGRAMS × BINS

uniform vec3 to_px;          // the velocity's x, y, z to px per frame
uniform float width;         // px a view width
uniform bool still;          // the frame is in the still part: its histograms filled
uniform bool weighed;        // z_position bound

const int SUMS = 12;
const int BINS = 4096;
const float BIN = 1.0 / 128.0;                       // px per frame a bin; the last holds all past it

shared float s_sums[256][SUMS];

void bin(int histogram, float value) {
    int index = min(int(value / BIN), BINS - 1);
    atomicAdd(uHistograms[histogram * BINS + index], 1u);
}

void main() {
    ivec2 size = textureSize(velocity, 0);
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    uint local = gl_LocalInvocationIndex;
    float sums[SUMS];
    for (int i = 0; i < SUMS; i++) sums[i] = 0.0;

    if (all(lessThan(at, size))) {
        uint bits = uint(round(texelFetch(regions, at, 0).r * 255.0));
        vec3 v = texelFetch(velocity, at, 0).xyz * to_px;
        float xy = length(v.xy);
        float z = v.z;
        vec4 track = texelFetch(estimate, at, 0);
        float track_z = track.r * width;
        bool core = (bits & 1u) != 0u;
        bool edge = (bits & 2u) != 0u;
        bool table = (bits & 4u) != 0u;
        bool moving = (bits & 8u) != 0u;
        bool mask = (bits & 16u) != 0u;
        if (core) {
            sums[0] += 1.0;
            sums[1] += xy;
            sums[2] += abs(z);
            sums[3] += track_z;
            if (texelFetch(before, at, 0).g > 0.0) {          // a track there the frame before
                sums[9] += 1.0;
                if (track.b == 0.0 && track.g > 0.0) sums[10] += 1.0;     // that now has no rate: it started over
            }
        }
        if (moving) {
            sums[4] += 1.0;
            sums[5] += xy;
            sums[6] += z;
            sums[7] += track_z;
        }
        if (mask) {
            sums[8] += 1.0;
            if (weighed && texelFetch(z_position, at, 0).g <= 0.0) sums[11] += 1.0;
        }
        if (still) {
            if (core) { bin(0, xy); bin(2, abs(z)); }
            if (edge) { bin(1, xy); bin(3, abs(z)); }
            if (table) bin(4, abs(z));
        }
    }

    for (int i = 0; i < SUMS; i++) s_sums[local][i] = sums[i];
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (local < stride) {
            for (int i = 0; i < SUMS; i++) s_sums[local][i] += s_sums[local + stride][i];
        }
        barrier();
    }
    if (local == 0u) {
        uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
        for (int i = 0; i < SUMS; i++) uPartials[group * uint(SUMS) + uint(i)] = s_sums[0][i];
    }
}
