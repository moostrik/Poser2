#version 460 core

/*
 * VorticityForce3D - 3D vorticity confinement force.
 *
 * F = ε * (N × ω) * Δt
 * where N = ∇|ω| / |∇|ω||  (normalized gradient of curl magnitude)
 *
 * In 3D, the confinement force is computed via cross product of N and ω.
 *
 * The spin input adds the same force from a 2D curl, ω along z, at the injection
 * depth: the motion's own rotation, which the sim's curl has not developed yet.
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler3D uCurl;      // Curl vector field (RGBA16F: xyz)
layout(binding = 1) uniform sampler3D uObstacle;   // Obstacle mask (R8)
layout(binding = 2) uniform sampler2D uSpin;       // 2D curl (R16F), read only while uSpinStep is not 0

layout(rgba16f, binding = 0) writeonly uniform image3D uForce;

uniform vec3  uHalfRdxInv;    // (0.5/dx, 0.5/dy, 0.5/dz)
uniform float uTimestep;       // Vorticity strength * dt
uniform ivec3 uSize;
uniform bool  uHasObstacles;   // Skip obstacle logic when no obstacles present
uniform float uSpinStep;       // Spin strength * dt, 0 = no spin input
uniform float uSpinLayer;      // Normalized depth [0, 1] of the injection
uniform float uSpinSpread;     // Gaussian sigma in normalized depth units

// Force of the 2D curl: F = N × (0, 0, ω) = (N.y, -N.x) * ω, faded by the gaussian slab
vec2 spinForce(float z_norm, vec2 uv) {
    float target_z = (0.5 + uSpinLayer * (float(uSize.z) - 1.0)) / float(uSize.z);
    float dz = (z_norm - target_z) / max(uSpinSpread, 0.001);
    float weight = exp(-0.5 * dz * dz);
    if (weight < 0.001) return vec2(0.0);

    vec2 texel = 1.0 / vec2(textureSize(uSpin, 0));
    vec2 gradient = vec2(
        abs(texture(uSpin, uv + vec2(texel.x, 0.0)).r) - abs(texture(uSpin, uv - vec2(texel.x, 0.0)).r),
        abs(texture(uSpin, uv + vec2(0.0, texel.y)).r) - abs(texture(uSpin, uv - vec2(0.0, texel.y)).r)
    );
    float gradient_length = length(gradient);
    if (gradient_length < 1e-6) return vec2(0.0);
    vec2 n = gradient / gradient_length;
    return uSpinStep * weight * texture(uSpin, uv).r * vec2(n.y, -n.x);
}

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xy, gl_WorkGroupID.z);
    if (any(greaterThanEqual(gid, uSize))) return;

    vec3 st = (vec3(gid) + 0.5) / vec3(uSize);

    // Obstacle check
    if (uHasObstacles) {
        float obstacle = texture(uObstacle, st).r;
        if (obstacle > 0.5) {
            imageStore(uForce, gid, vec4(0.0));
            return;
        }
    }

    vec3 texel = 1.0 / vec3(uSize);

    // Center curl
    vec3 curlC = texture(uCurl, st).xyz;
    float magC = length(curlC);

    // Gradient of curl magnitude (6 neighbors)
    float magR = length(texture(uCurl, st + vec3(texel.x, 0, 0)).xyz);
    float magL = length(texture(uCurl, st - vec3(texel.x, 0, 0)).xyz);
    float magT = length(texture(uCurl, st + vec3(0, texel.y, 0)).xyz);
    float magB = length(texture(uCurl, st - vec3(0, texel.y, 0)).xyz);
    float magF = length(texture(uCurl, st + vec3(0, 0, texel.z)).xyz);
    float magK = length(texture(uCurl, st - vec3(0, 0, texel.z)).xyz);

    vec3 gradMag = vec3(
        uHalfRdxInv.x * (magR - magL),
        uHalfRdxInv.y * (magT - magB),
        uHalfRdxInv.z * (magF - magK)
    );

    // Normalize
    float gradLen = length(gradMag);
    vec3 N = (gradLen > 1e-6) ? gradMag / gradLen : vec3(0.0);

    // Confinement force: F = ε * (N × ω) * dt  (standard Fedkiw formulation)
    // The 1/√3 factor that was here previously was compensating for a bug in
    // the 2D pipeline where internal forces were routed through add_velocity()
    // which applied an extra input_strength*dt. Now that both 2D and 3D use
    // direct force injection (_add_force_to_velocity), no correction is needed.
    vec3 force = uTimestep * cross(N, curlC);
    if (uSpinStep != 0.0) force.xy += spinForce(st.z, st.xy);

    imageStore(uForce, gid, vec4(force, 0.0));
}
