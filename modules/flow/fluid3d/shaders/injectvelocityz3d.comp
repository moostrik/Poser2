#version 460 core

/*
 * InjectVelocityZ3D - Inject signed Z-velocity (W channel) into the 3D
 *                     velocity volume from a 2D flow field.
 *
 * W is sourced from two signed terms, both clamped to ±uWClamp per voxel:
 *   squeeze: -divergence of the 2D flow (normalized-width units). With
 *            uSqueeze > 0, expanding motion (a person looming toward the
 *            camera, arms opening) pushes fluid toward the viewer (-W),
 *            converging motion (hands coming together) pushes it away (+W).
 *   push:    |flow| magnitude, one-directional. Positive = away from viewer.
 *
 * Sign convention: +W moves fluid toward higher layer indices, i.e. AWAY
 * from the viewer (the composite marches front-to-back from layer 0).
 *
 * Depth placement uses the same gaussian slab as Inject3D:
 *   weight = exp(-0.5 * ((z_norm - target) / spread)²) * uStrength
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// 2D flow velocity (RG16F, velocity in normalized-width units)
layout(binding = 0) uniform sampler2D uInput;

// 3D velocity volume (read-write; W = .z)
layout(rgba16f, binding = 0) uniform image3D uVolume;

// Parameters
uniform float uTargetLayer;  // Normalized depth [0, 1] — center of injection
uniform float uSpread;       // Gaussian sigma in normalized depth units
uniform float uStrength;     // Overall strength (input_strength_z * dt * motion)
uniform float uSqueeze;      // Gain on -divergence (signed)
uniform float uPush;         // Gain on |flow| (signed; + = away from viewer)
uniform float uWClamp;       // Abs clamp on the W source term
uniform ivec3 uSize;

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xy, gl_WorkGroupID.z);
    if (any(greaterThanEqual(gid, uSize))) return;

    // Gaussian weight along depth (same slab as the other injections)
    float z_norm = (float(gid.z) + 0.5) / float(uSize.z);
    float target = (0.5 + uTargetLayer * (float(uSize.z) - 1.0)) / float(uSize.z);
    float dz = (z_norm - target) / max(uSpread, 0.001);
    float weight = exp(-0.5 * dz * dz) * uStrength;

    if (abs(weight) < 0.0001) return;  // Skip negligible contributions

    vec2 uv = (vec2(gid.xy) + 0.5) / vec2(uSize.xy);
    vec2 texel = 1.0 / vec2(textureSize(uInput, 0));

    // Central-difference divergence in normalized units (matches the
    // velocity convention: 1.0 crosses the full width in 1 s at speed 1)
    float vR = texture(uInput, uv + vec2(texel.x, 0.0)).x;
    float vL = texture(uInput, uv - vec2(texel.x, 0.0)).x;
    float vT = texture(uInput, uv + vec2(0.0, texel.y)).y;
    float vB = texture(uInput, uv - vec2(0.0, texel.y)).y;
    float div = 0.5 * ((vR - vL) / texel.x + (vT - vB) / texel.y);

    vec2 v = texture(uInput, uv).xy;
    float w_src = clamp(uSqueeze * (-div) + uPush * length(v), -uWClamp, uWClamp);

    float add = w_src * weight;
    if (abs(add) < 1e-6) return;

    vec4 current = imageLoad(uVolume, gid);
    current.z += add;  // channel 2 = W (Z-velocity)
    imageStore(uVolume, gid, current);
}
