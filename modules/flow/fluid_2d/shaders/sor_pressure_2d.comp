#version 460 core

/*
 * SorPressure2D - one color's half sweep of red-black Gauss-Seidel with over-relaxation (SOR) on the 2D
 * pressure's Poisson equation, in place, as SorPressure3D on the plane.
 *
 * The cells are colored by (x + y) mod 2: a red cell's four neighbors are black, so each color's cells update in
 * parallel from the other color's newest values, Gauss-Seidel's order kept. Then
 *
 *     p = (1 - omega) p + omega * beta * (ax (pL + pR) + ay (pB + pT) - div)
 *
 * omega 1 is Gauss-Seidel; between 1 and 2 it over-relaxes. One thread a cell of the color: x is doubled and
 * offset by the color's parity. The walls are walls_2d.glsl's; an obstacle's face is Neumann.
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D uDivergence;  // R16F or R32F
layout(binding = 1) uniform sampler2D uObstacle;    // R8

layout(r32f, binding = 0) uniform image2D uPressure;

uniform vec2  uAlpha;        // (1/dx², 1/dy²)
uniform float uBeta;         // 1 / (2 ax + 2 ay + s), s the screened equation's 1 / reach² (0 none)
uniform float uOmega;        // the over-relaxation, 1 to 2
uniform int   uColor;        // 0 red, 1 black
uniform ivec2 uSize;
uniform bool  uHasObstacles;

#include "walls_2d.glsl"

bool isObstacle(ivec2 coord) {
    return texture(uObstacle, (vec2(coord) + 0.5) / vec2(uSize)).r > 0.5;
}

float neighbor(ivec2 coord, float pC) {
    if (any(lessThan(coord, ivec2(0))) || any(greaterThanEqual(coord, uSize))) return wall_pressure(pC);
    if (uHasObstacles && isObstacle(coord)) return pC;
    return imageLoad(uPressure, coord).r;
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 gid = ivec2(id.x * 2 + ((id.y + uColor) & 1), id.y);
    if (any(greaterThanEqual(gid, uSize))) return;

    if (uHasObstacles && isObstacle(gid)) {
        imageStore(uPressure, gid, vec4(0.0));
        return;
    }

    float pC = imageLoad(uPressure, gid).r;
    float pL = neighbor(gid - ivec2(1, 0), pC);
    float pR = neighbor(gid + ivec2(1, 0), pC);
    float pB = neighbor(gid - ivec2(0, 1), pC);
    float pT = neighbor(gid + ivec2(0, 1), pC);
    float divergence = texture(uDivergence, (vec2(gid) + 0.5) / vec2(uSize)).r;

    float gauss_seidel = uBeta * (uAlpha.x * (pL + pR) + uAlpha.y * (pB + pT) - divergence);
    imageStore(uPressure, gid, vec4(mix(pC, gauss_seidel, uOmega), 0.0, 0.0, 0.0));
}
