#version 460 core

/*
 * ResidualRestrict2D - the 2D multigrid's residual restricted to the next coarser level in one pass, as
 * ResidualRestrict3D on the plane: each coarse cell the mean of its fine cells' residuals (two along an axis the
 * level halves, one along one it keeps), div - L p, each worked out where it is read, never written at the fine level.
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D uDivergence;  // the fine level's right-hand side
layout(binding = 1) uniform sampler2D uObstacle;    // R8
layout(r32f, binding = 0) readonly uniform image2D uPressure;
layout(r32f, binding = 1) writeonly uniform image2D uCoarse;

uniform vec2  uAlpha;        // 1 / h², the fine level's, per axis
uniform ivec2 uFactor;       // per axis, 2 where the coarse level halves the fine, 1 where it keeps it
uniform ivec2 uSize;         // the fine level's cells
uniform ivec2 uCoarseSize;
uniform bool  uHasObstacles;

#include "walls_2d.glsl"

bool isObstacle(ivec2 coord) {
    return texture(uObstacle, (vec2(coord) + 0.5) / vec2(uSize)).r > 0.5;
}

float neighbor(ivec2 coord, float pC) {
    if (any(lessThan(coord, ivec2(0))) || any(greaterThanEqual(coord, uSize))) return wall_pressure(pC);
    if (uHasObstacles && isObstacle(coord)) return pC;
    return imageLoad(uPressure, coord).r;
}

float residual(ivec2 gid) {
    if (uHasObstacles && isObstacle(gid)) return 0.0;
    float pC = imageLoad(uPressure, gid).r;
    float laplacian = uAlpha.x * (neighbor(gid - ivec2(1, 0), pC) + neighbor(gid + ivec2(1, 0), pC) - 2.0 * pC)
                    + uAlpha.y * (neighbor(gid - ivec2(0, 1), pC) + neighbor(gid + ivec2(0, 1), pC) - 2.0 * pC);
    float divergence = texture(uDivergence, (vec2(gid) + 0.5) / vec2(uSize)).r;
    return divergence - laplacian;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gid, uCoarseSize))) return;
    float sum = 0.0;
    float count = 0.0;
    for (int k = 0; k < 4; k++) {
        ivec2 offset = ivec2(k & 1, (k >> 1) & 1);
        if (any(greaterThanEqual(offset, uFactor))) continue;      // an axis kept has one fine cell
        ivec2 fine = gid * uFactor + offset;
        if (any(greaterThanEqual(fine, uSize))) continue;
        sum += residual(fine);
        count += 1.0;
    }
    imageStore(uCoarse, gid, vec4(sum / max(count, 1.0), 0.0, 0.0, 0.0));
}
