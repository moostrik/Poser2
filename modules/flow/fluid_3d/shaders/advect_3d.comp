#version 460 core

/*
 * Advect3D - Semi-Lagrangian advection for 3D volumetric fields.
 *
 * Backward-traces along the 3D velocity field and samples the source
 * using trilinear interpolation (sampler3D). Border colors provide
 * implicit boundary conditions — no explicit obstacle border needed.
 * The velocity and the obstacle are sampled by uv, so the field may sit
 * on a finer grid than they do.
 *
 * Velocity is stored as RGBA16F with xyz = (u, v, w).
 */

layout(local_size_x = 8, local_size_y = 4, local_size_z = 8) in;     // a brick of cells, so z neighbors share the cache

// Input textures (sampler3D for trilinear filtered backtrace)
layout(binding = 0) uniform sampler3D uVelocity;  // Velocity field (RGBA16F: xyz = u,v,w)
layout(binding = 1) uniform sampler3D uSource;     // Field to advect (any format)
layout(binding = 2) uniform sampler3D uObstacle;   // Obstacle mask (R8)

// Output image
layout(rgba16f, binding = 0) writeonly uniform image3D uResult;

// Parameters
uniform float uTimestep;      // dt * speed
uniform vec3  uRdx;           // (1, width/height, 1/z_extent): the uv a width of each axis crosses
uniform float uDissipation;   // Exponential decay multiplier
uniform float uEvaporation;   // Subtracted this step; unlike the multiplicative fade it reaches
                              // zero, so low-level haze clears. 0 for a signed field
uniform int   uMeasure;       // how the evaporation reads a field's size: 0 its alpha, 1 its vector's length, 2 |r|
uniform ivec3 uSize;          // Volume dimensions (width, height, depth)
uniform bool  uHasObstacles;  // Skip obstacle logic when no obstacles present
uniform int   uGuardSlot;     // The field's slot in the stage's FiniteGuard; -1 no guard
uniform ivec3 uClosed;        // Per axis, 1 where the domain's walls are closed
uniform bool  uFromFaces;     // the velocity read from its faces (faces.glsl, a field on the simulation's grid), else uVelocity
uniform ivec3 uCells;         // the simulation's cells, with uFromFaces

#include "walls.glsl"
#include "faces.glsl"

// The stage's non-finite counts (FiniteGuard, GUARD_BINDING)
layout(std430, binding = 7) buffer FiniteGuard { uint uNonFinite[]; };

// The evaporation: the field's size taken down by uEvaporation, every channel scaled with it, so a
// color keeps its hue, a velocity its direction and a signed value its sign; its size the alpha of a
// premultiplied density (0), the length of a vector (1), or the first channel's magnitude (2)
vec4 evaporate(vec4 value) {
    float size = uMeasure == 0 ? value.a : (uMeasure == 1 ? length(value.xyz) : abs(value.r));
    if (size <= 0.0) return value;
    return value * (max(size - uEvaporation, 0.0) / size);
}

// The guard: a value whose exponent bits are all ones is an infinity or a NaN; it becomes 0 and is counted.
// A cell is counted once: where it held one (`held`, before the step reads it) or where the step made one
bool non_finite(vec4 value) {
    return any(equal(floatBitsToUint(value) & 0x7F800000u, uvec4(0x7F800000u)));
}

bool held(ivec3 gid) {
    if (uGuardSlot < 0 || !non_finite(texelFetch(uSource, gid, 0))) return false;
    atomicAdd(uNonFinite[uGuardSlot], 1u);
    imageStore(uResult, gid, vec4(0.0));
    return true;
}

vec4 guard(vec4 value) {
    if (uGuardSlot < 0 || !non_finite(value)) return value;
    atomicAdd(uNonFinite[uGuardSlot], 1u);
    return vec4(0.0);
}

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xyz);

    // Bounds check
    if (any(greaterThanEqual(gid, uSize))) return;
    if (held(gid)) return;      // a non-finite value held: 0, counted, not traced

    // Normalized 3D texture coordinates (center of voxel)
    vec3 st = (vec3(gid) + 0.5) / vec3(uSize);

    // Obstacle check — write current source value (not black) so trilinear
    // sampling across the boundary extrapolates smoothly instead of bleeding zeros.
    if (uHasObstacles) {
        float obstacle = texture(uObstacle, st).r;
        if (obstacle > 0.5) {
            imageStore(uResult, gid, texture(uSource, st));
            return;
        }
    }

    // Backward trace along 3D velocity
    vec3 velocity = uFromFaces ? velocity_at(st * vec3(uCells)) : texture(uVelocity, st).xyz;
    vec3 st_back = st - uTimestep * uRdx * velocity;

    // If backtrace lands inside an obstacle, fall back to current position
    // (no advection) to prevent sampling from zeroed obstacle interior.
    if (uHasObstacles && texture(uObstacle, st_back).r > 0.5) {
        st_back = st;
    }

    // Sample source with trilinear interpolation and apply dissipation
    vec4 result = uDissipation * texture(uSource, st_back);
    if (uEvaporation > 0.0) {
        result = evaporate(result);
    }

    result = guard(result);
    imageStore(uResult, gid, result);
}
