#version 460 core

/*
 * Buoyancy3D - the buoyancy on the velocity grid, an acceleration (widths/s²) the fluid adds × dt.
 *
 * F = uGravity * (κ·density - σ(T - T_ambient)):
 *   dense density sinks along gravity; hot density rises against it.
 * The weight term acts wherever density is (not gated by temperature),
 * so accumulated old density settles even after it has cooled.
 * The density may sit on a finer grid than the force; it is sampled by uv.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;     // a brick of cells, so z neighbors share the cache

layout(binding = 0) uniform sampler3D uTemperature;  // Temperature (R16F)
layout(binding = 1) uniform sampler3D uDensity;      // Density (RGBA16F)
layout(binding = 2) uniform sampler3D uObstacle;     // Obstacle mask (R8)

layout(rgba16f, binding = 0) writeonly uniform image3D uForce;

uniform float uSigma;               // Thermal buoyancy (widths/s² per unit of temperature)
uniform float uKappa;               // Density weight (widths/s² per unit of density)
uniform float uAmbientTemperature;  // Reference temperature
uniform vec3  uGravity;             // Gravity direction: (0,1,0) down-screen, (0,0,1) away from viewer
uniform ivec3 uSize;
uniform bool  uHasObstacles;

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(gid, uSize))) return;

    vec3 st = (vec3(gid) + 0.5) / vec3(uSize);

    // Obstacle check
    if (uHasObstacles) {
        float obstacle = texture(uObstacle, st).r;
        if (obstacle > 0.5) {
            imageStore(uForce, gid, vec4(0.0));
            return;
        }
    }

    float temperature = texture(uTemperature, st).r;
    float dtemp = temperature - uAmbientTemperature;

    // Thermal lift where warm; the density's weight wherever density is
    float lift = (abs(dtemp) > 0.0001) ? dtemp * uSigma : 0.0;
    vec4 d = texture(uDensity, st);
    float density = max(d.r, max(d.g, d.b));
    float force = density * uKappa - lift;

    vec3 buoyancy = (abs(force) > 0.00001) ? uGravity * force : vec3(0.0);

    imageStore(uForce, gid, vec4(buoyancy, 0.0));
}
