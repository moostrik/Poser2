#version 460 core

/*
 * Divergence3D - the divergence of the velocity on the cells' faces (faces.glsl): per cell, its six faces'
 * one-cell differences,
 *
 *   div = (u(i+1) - u(i) + v(j+1) - v(j) + w(k+1) - w(k)) / h
 *
 * whose divergence of the gradient is the 7-point Laplacian the solvers solve. A face on a closed wall or an
 * obstacle's is 0, as stored: nothing flows through it. An obstacle's cell has no divergence.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;     // a brick of cells, so z neighbors share the cache

layout(binding = 2) uniform sampler3D uObstacle;   // R8 at the cells
layout(r16f, binding = 0) writeonly uniform image3D uDivergence;

uniform float uRdxInv;        // 1 / h, the cubic cell in widths
uniform ivec3 uCells;
uniform ivec3 uClosed;
uniform bool  uHasObstacles;

#include "walls.glsl"
#include "faces.glsl"

void main() {
    ivec3 i = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(i, uCells))) return;
    if (solid_cell(i)) {
        imageStore(uDivergence, i, vec4(0.0));
        return;
    }
    float div = face_fetch(0, i + ivec3(1, 0, 0)) - face_fetch(0, i)
              + face_fetch(1, i + ivec3(0, 1, 0)) - face_fetch(1, i)
              + face_fetch(2, i + ivec3(0, 0, 1)) - face_fetch(2, i);
    imageStore(uDivergence, i, vec4(div * uRdxInv, 0.0, 0.0, 0.0));
}
