#version 460 core

/*
 * ViscosityFaces3D - the viscosity on the cells' faces: Jacobi iterations of the implicit diffusion
 * (I - νΔt∇²) v_new = v_old, each component's 7-point Laplacian over its own faces (faces.glsl).
 *
 *   v^(k+1) = β (α Σ six neighbors + γ v_old),  γ = 1 / (ν Δt),  β = 1 / (6α + γ)
 *
 * One invocation an index, its three faces at once; a 16 × 16 × 2 tile with a one-index halo in shared
 * memory, iterated there. A face held at 0 (a closed wall's, an obstacle's) stays 0 and is read as 0. A
 * neighbor beyond a wall: across its own axis there is none past the wall's face, so the face itself (zero
 * gradient); along a closed wall the ghost carries (2k - 1) of the face (walls.glsl's slip), an open one the
 * face itself.
 */

#pragma optionNV(unroll all)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 2) in;

layout(binding = 2) uniform sampler3D uObstacle;

uniform ivec3 uCells;
uniform ivec3 uClosed;
uniform bool  uHasObstacles;
uniform float uAlpha;         // 1 / h²
uniform float uGamma;         // 1 / (ν Δt)
uniform float uBeta;          // 1 / (6 α + γ)
uniform int   uIterations;

#include "walls.glsl"
#include "faces.glsl"

shared vec4 s_faces[4][18][18];     // [z slot][y + 1][x + 1]: slot 0 the z halo below, 1 and 2 the pair, 3 above

// The three faces of index `i`, its cell's left, bottom and front, as stored; a component it holds no face of
// is weighted 0
vec4 load(ivec3 i) {
    return vec4(texelFetch(uFaces, clamp(i, ivec3(0), uCells), 0).xyz, 0.0);
}

// Per component, 1 where index `n`'s face is held at 0: on a closed wall (component c's walls lie across its own
// axis, so each component tests its own index, all three at once) or an obstacle's
vec3 held_at(ivec3 n) {
    vec3 wall = vec3(uClosed) * vec3(bvec3(uvec3(equal(n, ivec3(0))) | uvec3(equal(n, uCells))));
    if (!uHasObstacles) return wall;
    return max(wall, vec3(solid_face(0, n) ? 1.0 : 0.0, solid_face(1, n) ? 1.0 : 0.0, solid_face(2, n) ? 1.0 : 0.0));
}

// The weights of the neighbor one index along `axis` by `step` (±1), for x, y and z at once: three bits, set
// where its stored value counts (a held one reads 0), and to `own` × the face's own where it lies beyond a wall
// (across its own axis the face itself; along a closed wall (2k - 1) of it, the slip; an open one the face
// itself). Bits, not floats, to keep the registers few: the iterations run at the occupancy they allow
uint neighbor_weights(ivec3 i, int axis, int step, inout vec3 own) {
    ivec3 n = i;
    n[axis] += step;
    vec3 count = vec3(uCells[axis]);
    count[axis] += 1.0;                                 // along its own axis a component has one face more
    bvec3 beyond = n[axis] < 0 ? bvec3(true) : greaterThanEqual(vec3(float(n[axis])), count);
    vec3 ghost = vec3(uClosed[axis] == 1 ? 2.0 * uWallKeep - 1.0 : 1.0);
    ghost[axis] = 1.0;
    own += vec3(beyond) * ghost;
    bvec3 counts = not(bvec3(uvec3(beyond) | uvec3(held_at(n))));
    return uint(counts.x) | (uint(counts.y) << 1) | (uint(counts.z) << 2);
}

vec3 weight(uint mask, int direction) {
    uint bits = mask >> (3 * direction);
    return vec3(bits & 1u, (bits >> 1) & 1u, (bits >> 2) & 1u);
}

void main() {
    int lz = int(gl_LocalInvocationID.z);
    int gz = int(gl_WorkGroupID.z) * 2 + lz;
    ivec3 i = ivec3(gl_GlobalInvocationID.xy, gz);
    ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    ivec2 sid = lid + 1;
    int sz = lz + 1;
    ivec2 tile = ivec2(gl_WorkGroupID.xy) * 16;
    int zBase = int(gl_WorkGroupID.z) * 2;

    bool inside = all(lessThanEqual(i, uCells));
    vec4 v_old = inside ? load(i) : vec4(0.0);
    s_faces[sz][sid.y][sid.x] = v_old;
    if (lid.y == 0)  s_faces[sz][0][sid.x]  = load(ivec3(tile + ivec2(lid.x, -1), gz));
    if (lid.y == 15) s_faces[sz][17][sid.x] = load(ivec3(tile + ivec2(lid.x, 16), gz));
    if (lid.x == 0)  s_faces[sz][sid.y][0]  = load(ivec3(tile + ivec2(-1, lid.y), gz));
    if (lid.x == 15) s_faces[sz][sid.y][17] = load(ivec3(tile + ivec2(16, lid.y), gz));
    if (lz == 0) s_faces[0][sid.y][sid.x] = load(ivec3(i.xy, zBase - 1));
    if (lz == 1) s_faces[3][sid.y][sid.x] = load(ivec3(i.xy, zBase + 2));
    barrier();

    // The walls' and the obstacles' weights, fixed through the iterations: per direction the stored neighbor's
    // weight for x, y and z, and summed over the six the face's own; a held or missing face stays 0
    // Away from the walls and without obstacles every neighbor counts and none is a ghost: the weights cost
    // more than the iterations, so only the faces next to a wall or an obstacle work them out
    vec3 own = vec3(0.0);
    uint mask = 0x3FFFFu;
    bool interior = !uHasObstacles && all(greaterThanEqual(i, ivec3(2))) && all(lessThan(i, uCells - 1));
    if (!interior) {
        mask = neighbor_weights(i, 0, 1, own) | (neighbor_weights(i, 0, -1, own) << 3)
             | (neighbor_weights(i, 1, 1, own) << 6) | (neighbor_weights(i, 1, -1, own) << 9)
             | (neighbor_weights(i, 2, 1, own) << 12) | (neighbor_weights(i, 2, -1, own) << 15);
    }
    vec3 live = inside ? vec3(i.y < uCells.y && i.z < uCells.z, i.x < uCells.x && i.z < uCells.z, i.x < uCells.x && i.y < uCells.y) : vec3(0.0);
    if (!interior) live *= vec3(1.0) - held_at(i);

    vec3 current = v_old.xyz * live;
    for (int iteration = 0; iteration < uIterations; iteration++) {
        vec3 r = s_faces[sz][sid.y][sid.x + 1].xyz, l = s_faces[sz][sid.y][sid.x - 1].xyz;
        vec3 t = s_faces[sz][sid.y + 1][sid.x].xyz, b = s_faces[sz][sid.y - 1][sid.x].xyz;
        vec3 f = s_faces[sz + 1][sid.y][sid.x].xyz, k = s_faces[sz - 1][sid.y][sid.x].xyz;
        vec3 sum = interior ? r + l + t + b + f + k
                            : weight(mask, 0) * r + weight(mask, 1) * l + weight(mask, 2) * t + weight(mask, 3) * b
                              + weight(mask, 4) * f + weight(mask, 5) * k + own * current;
        vec3 next = live * (uBeta * (uAlpha * sum + uGamma * v_old.xyz));
        barrier();
        s_faces[sz][sid.y][sid.x] = vec4(next, 0.0);
        current = next;
        barrier();
    }
    if (inside) store_faces(i, current);
}
