#version 460 core

/*
 * VorticityForce3D - the 3D vorticity confinement's force at the cells, × dt, which AddToFaces3D adds to the faces.
 *
 * f = ε h (N × ω) Δt
 * where N = ∇|ω| / |∇|ω||  (normalized gradient of curl magnitude)
 *
 * In 3D, the confinement force is computed via cross product of N and ω. Each of uCount confinements gives its
 * own from its own curl and strength, summed: up to three sizes of swirl kept at once.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;     // a brick of cells, so z neighbors share the cache

const int MAX_CONFINEMENTS = 3;     // VorticityForce3D.MAX_CONFINEMENTS

layout(binding = 0) uniform sampler3D uCurl0;     // each confinement's curl (RGBA16F: xyz)
layout(binding = 2) uniform sampler3D uCurl1;
layout(binding = 3) uniform sampler3D uCurl2;
layout(binding = 1) uniform sampler3D uObstacle;   // Obstacle mask (R8)

layout(rgba16f, binding = 0) writeonly uniform image3D uForce;    // the force × dt at the cells

uniform vec3  uHalfRdxInv;    // (0.5/dx, 0.5/dy, 0.5/dz)
uniform int   uCount;                         // the confinements, 1 to MAX_CONFINEMENTS
uniform float uTimestep[MAX_CONFINEMENTS];    // each one's strength × h × dt
uniform ivec3 uSize;
uniform bool  uHasObstacles;   // Skip obstacle logic when no obstacles present

// One confinement's N × ω at `gid` (texture coordinate `st`), from its curl
vec3 confinement(sampler3D curl, ivec3 gid, vec3 st) {
    vec3 texel = 1.0 / vec3(uSize);

    // Center curl
    vec3 curlC = texture(curl, st).xyz;
    float magC = length(curlC);

    // Gradient of curl magnitude (6 neighbors)
    float magR = length(texture(curl, st + vec3(texel.x, 0, 0)).xyz);
    float magL = length(texture(curl, st - vec3(texel.x, 0, 0)).xyz);
    float magT = length(texture(curl, st + vec3(0, texel.y, 0)).xyz);
    float magB = length(texture(curl, st - vec3(0, texel.y, 0)).xyz);
    float magF = length(texture(curl, st + vec3(0, 0, texel.z)).xyz);
    float magK = length(texture(curl, st - vec3(0, 0, texel.z)).xyz);

    // Beyond the box the wall's ghost has this cell's curl, mirrored, so its size is the same: no slope toward
    // the wall for the force to push along (the curl volume's border of 0 made every wall a cliff of |curl|)
    if (gid.x + 1 >= uSize.x) magR = magC;
    if (gid.x - 1 < 0)        magL = magC;
    if (gid.y + 1 >= uSize.y) magT = magC;
    if (gid.y - 1 < 0)        magB = magC;
    if (gid.z + 1 >= uSize.z) magF = magC;
    if (gid.z - 1 < 0)        magK = magC;
    // An obstacle's cell is a closed wall inside the box: its curl's size this cell's, as beyond the walls
    if (uHasObstacles) {
        if (texture(uObstacle, st + vec3(texel.x, 0, 0)).r > 0.5) magR = magC;
        if (texture(uObstacle, st - vec3(texel.x, 0, 0)).r > 0.5) magL = magC;
        if (texture(uObstacle, st + vec3(0, texel.y, 0)).r > 0.5) magT = magC;
        if (texture(uObstacle, st - vec3(0, texel.y, 0)).r > 0.5) magB = magC;
        if (texture(uObstacle, st + vec3(0, 0, texel.z)).r > 0.5) magF = magC;
        if (texture(uObstacle, st - vec3(0, 0, texel.z)).r > 0.5) magK = magC;
    }

    vec3 gradMag = vec3(
        uHalfRdxInv.x * (magR - magL),
        uHalfRdxInv.y * (magT - magB),
        uHalfRdxInv.z * (magF - magK)
    );

    // Normalize
    float gradLen = length(gradMag);
    vec3 N = (gradLen > 1e-6) ? gradMag / gradLen : vec3(0.0);

    // Confinement force: F = ε * (N × ω) * dt  (standard Fedkiw formulation), ε dt the caller's
    return cross(N, curlC);

}

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(gid, uSize))) return;

    vec3 st = (vec3(gid) + 0.5) / vec3(uSize);

    // Obstacle check
    if (uHasObstacles) {
        float obstacle = texture(uObstacle, st).r;
        if (obstacle > 0.5) {
            imageStore(uForce, gid, vec4(0.0));
            return;
        }
    }

    vec3 force = uTimestep[0] * confinement(uCurl0, gid, st);
    if (uCount > 1) force += uTimestep[1] * confinement(uCurl1, gid, st);
    if (uCount > 2) force += uTimestep[2] * confinement(uCurl2, gid, st);

    imageStore(uForce, gid, vec4(force, 0.0));
}
