#version 460 core

/*
 * Composite3D - Volumetric front-to-back composite of the RGBA density
 * volume into a 2D image, one step per layer.
 *
 * Per ray step (front -> back, trilinear reads):
 *   occlusion    Beer-Lambert extinction; near density covers far density
 *   fog          the water's extinction per channel: far density fades, toward the water's color
 *   glow         each layer's own light, its color × uEmission × the share of the layer's light that is the
 *                density's, exact for an even layer: its part of the layer's extinction × what the layer
 *                takes out, so thick density is seen at its color × uEmission at any number of layers
 *   light        with uLit, each sample lit as well: its color × the light per layer of the march (the sun's
 *                and the sky's, LayerLight3D) × the caustic net on the sun's share × uIntensity, the net at
 *                its own size
 *   rays         with uHasRays, the water's own light in the layer (LayerLight3D), under what lies in front
 *
 * Dispatched as a 2D compute (one thread per output pixel). The output may
 * be larger than the volume: the volume is sampled by uv. Split, the amount is
 * one volume and its color another, coarser: the color is the density's
 * color × amount over its amount, at the same place, each with COLOR_FLOOR of white
 * added, so where the coarse amount thins out under the finer one the color fades to
 * white instead of dividing by almost nothing (which drew the coarse cells as blocks).
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

const float COLOR_FLOOR = 0.01;     // the coarse amount below which the split color leans to white

layout(binding = 0) uniform sampler3D uDensity;  // RGBA16F, or with uSplit the amount alone (R16F)
layout(binding = 1) uniform sampler3D uColor;    // with uSplit: the density, color × amount and the amount
layout(binding = 2) uniform sampler3D uDirect;   // with uLit: the direct light per layer, RGB; alpha the caustic net's contrast
layout(binding = 3) uniform sampler3D uRays;     // with uHasRays: the water's light, a column and a layer each

layout(rgba16f, binding = 0) writeonly uniform image2D uOutput;

#include "light.glsl"

uniform int   uDepth;        // Number of layers, the march's steps
uniform ivec2 uOutputSize;   // 2D output dimensions
uniform float uEmission;     // the glow of thick density, 1 = its own color
uniform float uAbsorption;   // The extinction of an amount of 1 over the whole view
uniform vec3  uFog;          // the water's extinction over the full depth, per channel
uniform bool  uSplit;        // the amount from uDensity, its color from uColor (the fine density)
uniform bool  uLit;          // the density lit by uDirect
uniform bool  uHasRays;      // the water's light added from uRays
uniform float uIntensity;    // the light on thick density at full light, 1 = its own color

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gid, uOutputSize))) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(uOutputSize);

    int steps = max(uDepth, 1);
    float inv_steps = 1.0 / float(steps);

    float sigma = uAbsorption / float(steps);     // per layer: the depth's over its layers
    vec3 fog_s = uFog / float(steps);

    vec3 T   = vec3(1.0);  // transmittance
    vec3 vol = vec3(0.0);  // occluded accumulation

    for (int i = 0; i < steps; i++) {
        float z_norm = (float(i) + 0.5) * inv_steps;
        vec3 uvw = vec3(uv, z_norm);
        vec4 s = texture(uDensity, uvw);
        if (uSplit) {
            vec4 c = texture(uColor, uvw);
            s = vec4((max(c.rgb, vec3(0.0)) + COLOR_FLOOR) / (max(c.a, 0.0) + COLOR_FLOOR) * s.r, s.r);
        }

        vec3 dye = max(s.rgb, vec3(0.0));
        float d = max(s.a, 0.0);          // the amount: the same amount covers the same, whatever its color
        vec3 taken = sigma * d + fog_s;
        vec3 through = exp(-taken);
        // the density's light per unit of its amount: its share of what the layer takes out, over the amount
        vec3 sent = d > 1e-6 ? (sigma / max(taken, vec3(1e-9))) * (1.0 - through) : vec3(sigma);
        vec3 e = uEmission * dye * sent;
        if (uLit) {
            vec4 direct = texture(uDirect, uvw);
            vec3 reaching = direct.rgb;
            if (direct.a > 0.0) {       // the caustic net, at its own size, by its contrast there
                reaching *= 1.0 + direct.a * (caustic_net(uvw) - 1.0);
            }
            e += uIntensity * dye * sent * reaching;
        }
        if (uHasRays) {
            e += texture(uRays, uvw).rgb;     // the layer's middle: its own value, not its neighbors'
        }
        vol += T * e;
        T *= through;

        if (all(lessThan(T, vec3(0.004)))) break;     // fully occluded
    }

    vec3 rgb = vol;
    float alpha = 1.0 - dot(T, vec3(0.299, 0.587, 0.114));
    imageStore(uOutput, gid, vec4(rgb, alpha));
}
