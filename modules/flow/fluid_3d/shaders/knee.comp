#version 460 core

/*
 * Knee - the composited output's highlights bent instead of clipped: each channel straight up to
 * KNEE and bent softly toward 1 above it, so the image below the knee keeps its contrast and its
 * brightest drift a little toward white, as film does. The color is premultiplied; the alpha stays.
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform image2D uOutput;

uniform ivec2 uOutputSize;

const float KNEE = 0.8;         // the brightness below which nothing changes

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gid, uOutputSize))) return;
    vec4 color = imageLoad(uOutput, gid);
    vec3 above = max(color.rgb - KNEE, 0.0);
    vec3 bent = KNEE + (1.0 - KNEE) * (1.0 - exp(-above / (1.0 - KNEE)));
    imageStore(uOutput, gid, vec4(mix(color.rgb, bent, step(KNEE, color.rgb)), color.a));
}
