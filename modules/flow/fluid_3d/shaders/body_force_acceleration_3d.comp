#version 460 core

/*
 * BodyForceAcceleration3D - the body force: an acceleration added to the velocity volume × dt in
 * the gaussian birth slab, the Navier–Stokes force term.
 *
 *     v <- v + a * strength * slab,    strength = weight * gain * dt
 *
 * The input holds the acceleration, x and y on the image plane and z toward the camera. The
 * volume's w points away from the viewer, so w is -z. slab is the gaussian,
 * exp(-0.5 * ((z_norm - target) / spread)²).
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// The acceleration (RGBA16F: x, y, z toward the camera; widths/s²)
layout(binding = 0) uniform sampler2D uInput;

// The velocity volume (read-write; u,v,w = .xyz)
layout(rgba16f, binding = 0) uniform image3D uVolume;

// Parameters
uniform float uTargetLayer;  // Normalized depth [0, 1] — center of the slab
uniform float uSpread;       // Gaussian sigma in normalized depth units
uniform float uStrength;     // weight * gain * dt
uniform ivec3 uSize;

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xy, gl_WorkGroupID.z);
    if (any(greaterThanEqual(gid, uSize))) return;

    // Gaussian weight along depth
    float z_norm = (float(gid.z) + 0.5) / float(uSize.z);
    float target_z = (0.5 + uTargetLayer * (float(uSize.z) - 1.0)) / float(uSize.z);
    float dz = (z_norm - target_z) / max(uSpread, 0.001);
    float slab = exp(-0.5 * dz * dz);
    if (slab < 0.001) return;

    vec2 uv = (vec2(gid.xy) + 0.5) / vec2(uSize.xy);
    vec3 acceleration = texture(uInput, uv).xyz;

    vec3 add = vec3(acceleration.xy, -acceleration.z) * uStrength * slab;
    if (dot(abs(add), vec3(1.0)) < 1e-7) return;

    vec4 current = imageLoad(uVolume, gid);
    current.xyz += add;
    imageStore(uVolume, gid, current);
}
