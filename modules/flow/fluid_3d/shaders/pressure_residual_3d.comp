#version 460 core

/*
 * PressureResidual3D - the residual of the pressure's Poisson equation, r = div - L p, with
 * L p = a (pL + pR + pB + pT + pK + pF - 6 p), the walls as the solvers take them: beyond a closed wall
 * the ghost is the cell's own pressure, beyond an open one 0; an obstacle's face is the cell's own.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(binding = 0) uniform sampler3D uDivergence;  // the right-hand side
layout(binding = 1) uniform sampler3D uObstacle;    // R8
layout(r32f, binding = 0) readonly uniform image3D uPressure;
layout(r32f, binding = 1) writeonly uniform image3D uResidual;

uniform float uAlpha;        // 1 / h²
uniform ivec3 uSize;
uniform bool  uHasObstacles;
uniform ivec3 uClosed;

bool isObstacle(ivec3 coord) {
    return texture(uObstacle, (vec3(coord) + 0.5) / vec3(uSize)).r > 0.5;
}

float neighbor(ivec3 coord, float pC, int axis) {
    if (coord[axis] < 0 || coord[axis] >= uSize[axis]) return uClosed[axis] == 1 ? pC : 0.0;
    if (uHasObstacles && isObstacle(coord)) return pC;
    return imageLoad(uPressure, coord).r;
}

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(gid, uSize))) return;
    if (uHasObstacles && isObstacle(gid)) {
        imageStore(uResidual, gid, vec4(0.0));
        return;
    }
    float pC = imageLoad(uPressure, gid).r;
    float sum = neighbor(gid - ivec3(1, 0, 0), pC, 0) + neighbor(gid + ivec3(1, 0, 0), pC, 0)
              + neighbor(gid - ivec3(0, 1, 0), pC, 1) + neighbor(gid + ivec3(0, 1, 0), pC, 1)
              + neighbor(gid - ivec3(0, 0, 1), pC, 2) + neighbor(gid + ivec3(0, 0, 1), pC, 2);
    float divergence = texture(uDivergence, (vec3(gid) + 0.5) / vec3(uSize)).r;
    imageStore(uResidual, gid, vec4(divergence - uAlpha * (sum - 6.0 * pC), 0.0, 0.0, 0.0));
}
