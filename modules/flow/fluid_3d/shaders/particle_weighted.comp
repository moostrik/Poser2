#version 460 core

/*
 * ParticleWeighted - the weighted look's three targets into the 2D output (McGuire and Bavoil 2013): the
 * weighted emission over the weighted opacity is the ink's color where it shows, times the opacity the
 * revealage leaves; the plain emission sum is the glow, mixed in by uGlow as the march mixes it.
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D uWeightedSum;  // RGBA32F: Σ w e, Σ w alpha
layout(binding = 1) uniform sampler2D uReveal;       // RGBA16F: Π (1 - alpha) per channel
layout(binding = 2) uniform sampler2D uAdditive;     // RGBA16F: Σ e

layout(rgba16f, binding = 0) writeonly uniform image2D uOutput;

uniform ivec2 uOutputSize;
uniform float uGlow;

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gid, uOutputSize))) return;
    vec4 sum = texelFetch(uWeightedSum, gid, 0);
    vec3 reveal = texelFetch(uReveal, gid, 0).rgb;
    vec3 add = texelFetch(uAdditive, gid, 0).rgb;
    vec3 shown = sum.a > 1e-6 ? sum.rgb / sum.a * (1.0 - reveal) : vec3(0.0);
    vec3 rgb = mix(shown, add, uGlow);
    float alpha = 1.0 - dot(reveal, vec3(0.299, 0.587, 0.114));
    imageStore(uOutput, gid, vec4(rgb, alpha));
}
