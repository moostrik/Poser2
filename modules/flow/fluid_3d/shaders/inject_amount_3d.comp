#version 460 core

/*
 * InjectAmount3D - a 2D source's amount (its alpha) into a one-channel volume, in the gaussian slab around
 * each pixel's z position (uTargetLayer without one), as Inject3D adds the whole RGBA, one invocation a column. The source is read by uv, so the volume may be finer: then
 * uCubic enlarges it by a cubic B-spline, smooth through the source's texel corners, where a bilinear read keeps
 * them as steps a source texel apart; four bilinear reads (Sigg and Hadwiger, GPU Gems 2).
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;   // a column of cells each

layout(binding = 0) uniform sampler2D uInput;      // RGBA: the amount times the color, the amount as alpha
layout(binding = 1) uniform sampler2D uZPosition;  // its z position, red over green
layout(r16f, binding = 0) uniform image3D uVolume;

uniform float uTargetLayer;  // normalized depth [0, 1] of the slab's center where the source has no z position
uniform bool  uHasZPosition;
uniform float uSpread;       // the gaussian's sigma in normalized depth
uniform float uStrength;
uniform bool  uCubic;        // the source enlarged by a cubic B-spline, else bilinearly
uniform int   uMode;         // 0 ADD, 1 RATE (capped at 1), 2 FILL (toward the source's amount × uGain, at most 1, never past it)
uniform float uGain;         // FILL: the source's amount times this, at most 1, is the target
uniform ivec3 uSize;

float bspline_alpha(vec2 uv) {
    vec2 size = vec2(textureSize(uInput, 0));
    vec2 position = uv * size - 0.5;
    vec2 base = floor(position);
    vec2 f = position - base;
    vec2 w0 = (1.0 - f) * (1.0 - f) * (1.0 - f) / 6.0;
    vec2 w1 = (4.0 - 6.0 * f * f + 3.0 * f * f * f) / 6.0;
    vec2 w2 = (1.0 + 3.0 * f + 3.0 * f * f - 3.0 * f * f * f) / 6.0;
    vec2 w3 = f * f * f / 6.0;
    vec2 s0 = w0 + w1;
    vec2 s1 = w2 + w3;
    vec2 t0 = (base - 1.0 + w1 / s0 + 0.5) / size;
    vec2 t1 = (base + 1.0 + w3 / s1 + 0.5) / size;
    return s0.x * s0.y * texture(uInput, t0).a + s1.x * s0.y * texture(uInput, vec2(t1.x, t0.y)).a
         + s0.x * s1.y * texture(uInput, vec2(t0.x, t1.y)).a + s1.x * s1.y * texture(uInput, t1).a;
}

#include "slab.glsl"

void main() {
    ivec2 column = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(column, uSize.xy))) return;
    vec2 uv = (vec2(column) + 0.5) / vec2(uSize.xy);
    float source = uCubic ? bspline_alpha(uv) : texture(uInput, uv).a;
    if (source == 0.0) return;      // nothing to add or fill: the column stays as it is, unread and unwritten
    float center = slab_center(uv);
    ivec2 cells = slab_cells(center, uSize.z);
    for (int z = cells.x; z <= cells.y; z++) {
        float weight = slab_cell(z, center, uSize.z) * uStrength;     // the body's share of this cell (slab.glsl)
        if (weight < 0.001) continue;
        ivec3 gid = ivec3(column, z);
        float current = imageLoad(uVolume, gid).r;
        if (uMode == 2) current += max(min(source * uGain, 1.0) - current, 0.0) * min(weight, 1.0);
        else current += source * weight;
        if (uMode == 1) current = min(current, 1.0);
        imageStore(uVolume, gid, vec4(current, 0.0, 0.0, 0.0));
    }
}
