#version 460 core

/*
 * InjectAmount3D - a density's amount into a one-channel volume, in the gaussian slab around each pixel's z
 * position (nothing without one), as InjectDensity3D blends the whole density, one invocation a column: the
 * bridge's amount (uInput's red, density_blend.glsl) times its color's alpha, the coverage, blended in by the
 * body's share of the cell × uStrength (× uRelease where it falls). The amount is read by uv, so the volume
 * may be finer: then uCubic enlarges it by a cubic B-spline, smooth through the amount's texel corners, where
 * a bilinear read keeps them as steps a texel apart; four bilinear reads (Sigg and Hadwiger, GPU Gems 2).
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;   // a column of cells each

layout(binding = 0) uniform sampler2D uInput;      // the amount, red
layout(binding = 1) uniform sampler2D uZPosition;  // its z position, red over green
layout(binding = 2) uniform sampler2D uColor;      // the amount's color, premultiplied by its alpha
layout(r16f, binding = 0) uniform image3D uVolume;

uniform bool  uHasZPosition;
uniform float uSpread;       // the gaussian's sigma in normalized depth
uniform float uStrength;     // over, fill: the drag's share this step; add: dt
uniform float uRelease;      // the release's share this step where the cell falls; 0 = never falls
uniform bool  uCubic;       // the source enlarged by a cubic B-spline, else bilinearly
uniform ivec3 uSize;

#include "density_blend.glsl"

float bspline_amount(vec2 uv) {
    vec2 size = vec2(textureSize(uInput, 0));
    vec2 position = uv * size - 0.5;
    vec2 base = floor(position);
    vec2 f = position - base;
    vec2 w0 = (1.0 - f) * (1.0 - f) * (1.0 - f) / 6.0;
    vec2 w1 = (4.0 - 6.0 * f * f + 3.0 * f * f * f) / 6.0;
    vec2 w2 = (1.0 + 3.0 * f + 3.0 * f * f - 3.0 * f * f * f) / 6.0;
    vec2 w3 = f * f * f / 6.0;
    vec2 s0 = w0 + w1;
    vec2 s1 = w2 + w3;
    vec2 t0 = (base - 1.0 + w1 / s0 + 0.5) / size;
    vec2 t1 = (base + 1.0 + w3 / s1 + 0.5) / size;
    return s0.x * s0.y * texture(uInput, t0).r + s1.x * s0.y * texture(uInput, vec2(t1.x, t0.y)).r
         + s0.x * s1.y * texture(uInput, vec2(t0.x, t1.y)).r + s1.x * s1.y * texture(uInput, t1).r;
}

#include "slab.glsl"

void main() {
    ivec2 column = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(column, uSize.xy))) return;
    vec2 uv = (vec2(column) + 0.5) / vec2(uSize.xy);
    float amount = uCubic ? bspline_amount(uv) : texture(uInput, uv).r;
    float coverage = texture(uColor, uv).a;
    float source = density_amount(amount) * coverage;
    float level = density_level(amount);     // over and add: what the release falls toward
    if (source <= 0.0) return;      // nothing to blend in: the column stays as it is, unread and unwritten
    float center = slab_center(uv);
    if (center == NO_Z_POSITION) return;
    ivec2 cells = slab_cells(center, uSize.z);
    for (int z = cells.x; z <= cells.y; z++) {
        float slab = slab_cell(z, center, uSize.z);     // the body's share of this cell (slab.glsl)
        float share = slab * uStrength;
        float release = release_share(slab * uRelease, coverage);
        if (max(share, release) < 0.001) continue;
        ivec3 gid = ivec3(column, z);
        float current = imageLoad(uVolume, gid).r;
        current = blend_density(vec4(0.0, 0.0, 0.0, current), vec4(0.0, 0.0, 0.0, source), level, share,
                                release).a;
        imageStore(uVolume, gid, vec4(current, 0.0, 0.0, 0.0));
    }
}
