#version 460 core

/*
 * ParticleSurfaceShade - the surface's shading: the normals from the smoothed depth, the ink's
 * color through its thickness (Beer-Lambert, absorption, the water's tint), a diffuse light, a
 * specular and a Fresnel edge; the fog by its depth. The viewer looks along +z from the front.
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D uDepth;       // R32F, smoothed, 1 = empty
layout(binding = 1) uniform sampler2D uThickness;   // R32F
layout(binding = 2) uniform sampler2D uColor;       // RGBA16F: rgb × weight, weight

layout(rgba16f, binding = 0) writeonly uniform image2D uOutput;

uniform ivec2 uSize;
uniform float uDepthPerPixel;   // widths per pixel of the volume's z: width × z_extent
uniform float uEmission;
uniform float uAbsorption;
uniform float uTint;
uniform float uFog;

const vec3 WATER_CHAN = vec3(1.8, 1.0, 0.6);
const vec3 LIGHT = vec3(-0.35, 0.55, -0.76);      // toward the light: up left, in front

float depthAt(ivec2 p, float fallback) {
    float d = texelFetch(uDepth, clamp(p, ivec2(0), uSize - 1), 0).r;
    return d >= 1.0 ? fallback : d;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gid, uSize))) return;
    float z = texelFetch(uDepth, gid, 0).r;
    if (z >= 1.0) {
        imageStore(uOutput, gid, vec4(0.0));
        return;
    }

    // The slope in pixels of depth per pixel across
    float dzdx = 0.5 * (depthAt(gid + ivec2(1, 0), z) - depthAt(gid - ivec2(1, 0), z)) * uDepthPerPixel;
    float dzdy = 0.5 * (depthAt(gid + ivec2(0, 1), z) - depthAt(gid - ivec2(0, 1), z)) * uDepthPerPixel;
    vec3 n = normalize(vec3(dzdx, dzdy, -1.0));
    vec3 v = vec3(0.0, 0.0, -1.0);
    vec3 l = normalize(LIGHT);

    vec4 color = texelFetch(uColor, gid, 0);
    vec3 base = color.rgb / max(color.a, 1e-6);
    float thickness = texelFetch(uThickness, gid, 0).r;
    vec3 chan = mix(vec3(1.0), WATER_CHAN, uTint);
    vec3 T = exp(-uAbsorption * thickness * chan);
    float alpha = 1.0 - dot(T, vec3(0.299, 0.587, 0.114));

    float diffuse = 0.55 + 0.45 * max(dot(n, l), 0.0);
    float specular = 0.6 * pow(max(dot(n, normalize(l + v)), 0.0), 64.0);
    float fresnel = 0.04 + 0.96 * pow(1.0 - max(dot(n, v), 0.0), 5.0);
    vec3 rgb = uEmission * base * (1.0 - T) * diffuse + vec3(specular + 0.25 * fresnel) * alpha;
    rgb *= exp(-uFog * z * chan);
    imageStore(uOutput, gid, vec4(rgb, alpha));
}
