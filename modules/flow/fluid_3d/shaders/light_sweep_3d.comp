#version 460 core

/*
 * LightSweep3D - a sun's light through the box in one sweep: parallel lines along the light's travel, one
 * thread a line, each stepping one light cell a step along the axis the light mostly travels (the sweep
 * axis) and sliding across the other two by the light's slope. Each line carries the optical depth from
 * the entry layer's plane, the density's amount × uSigma inside the box (read where the line passes) and
 * the water's uFog all the way (the water goes on past the box's sides, so light entering a side has come
 * down as far); and in alpha the density's alone, grey, for the powder.
 *
 * The grid is stored sheared, a line a column: layer k of line i at texel (i, k), where the line passes
 * i + 0.5 + slope × k cells across. A reader maps a place to that texel (`sweep_map`) and the texture's
 * filtering mixes the four lines around it, so every place gets the light of straight lines, never a
 * line's sideways step, which shows as stripes across the lit density. One density read a line a layer,
 * where a march from every cell toward the sun reads its whole way.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler3D uDensity;     // RGBA16F: color × amount, the amount as alpha
layout(rgba16f, binding = 0) writeonly uniform image3D uLight;   // sheared: a line a column

uniform ivec3 uSize;          // the light grid's cells, unsheared
uniform int   uAxis;          // the sweep axis: 0 x, 1 y, 2 z
uniform int   uDirection;     // +1: the light travels toward higher cells along the sweep axis, -1 lower
uniform vec2  uSlope;         // cells slid across (the other two axes, in order) per cell along the sweep axis
uniform ivec2 uLineStart;     // the first line across, before the first cell where the light slides in from a side
uniform ivec2 uLines;         // the lines across
uniform vec3  uSigma;         // the density's extinction per width per unit of amount, per channel
uniform vec3  uFog;           // the water's extinction per width, per channel
uniform float uStep;          // a step's length along the line, widths

ivec3 to_grid(int along, ivec2 across) {
    if (uAxis == 0) return ivec3(along, across.x, across.y);
    if (uAxis == 1) return ivec3(across.x, along, across.y);
    return ivec3(across.x, across.y, along);
}

vec3 to_grid(float along, vec2 across) {
    if (uAxis == 0) return vec3(along, across.x, across.y);
    if (uAxis == 1) return vec3(across.x, along, across.y);
    return vec3(across.x, across.y, along);
}

void main() {
    ivec2 column = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(column, uLines))) return;
    int n_along = uAxis == 0 ? uSize.x : (uAxis == 1 ? uSize.y : uSize.z);
    ivec2 n_across = uAxis == 0 ? uSize.yz : (uAxis == 1 ? uSize.xz : uSize.xy);
    vec2 line = vec2(column + uLineStart);
    vec3 size = vec3(uSize);

    // The layers where the line is in the box across, a cell around it for the readers' mixing: before them
    // it has crossed only water, after them nothing reads it
    float first = 0.0;
    float last = float(n_along - 1);
    for (int b = 0; b < 2; b++) {
        float low = -1.0 - (line[b] + 0.5);
        float high = float(n_across[b]) + 1.0 - (line[b] + 0.5);
        if (abs(uSlope[b]) < 1e-6) {
            if (low > 0.0 || high < 0.0) return;
        } else {
            float a = low / uSlope[b];
            float c = high / uSlope[b];
            first = max(first, min(a, c));
            last = min(last, max(a, c));
        }
    }
    if (first > last) return;
    int k_first = int(floor(first));
    int k_last = int(ceil(last));

    vec3 depth = float(k_first) * uStep * uFog;           // the water crossed before
    float dyed = 0.0;                           // the density's alone, grey
    for (int k = k_first; k <= k_last; k++) {
        int along = uDirection > 0 ? k : n_along - 1 - k;
        vec2 here = line + 0.5 + uSlope * float(k);     // where the line passes, in cells across
        vec3 half_step = 0.5 * uStep * uFog;
        float half_dyed = 0.0;
        if (all(greaterThanEqual(here, vec2(0.0))) && all(lessThan(here, vec2(n_across)))) {
            float amount = max(texture(uDensity, to_grid(float(along) + 0.5, here) / size).a, 0.0);
            half_dyed = 0.5 * uStep * uSigma.g * amount;      // green: the grey density's
            half_step += 0.5 * uStep * uSigma * amount;
        }
        imageStore(uLight, to_grid(along, column), exp(-vec4(depth + half_step, dyed + half_dyed)));
        depth += 2.0 * half_step;
        dyed += 2.0 * half_dyed;
    }
}
