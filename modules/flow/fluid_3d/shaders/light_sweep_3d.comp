#version 460 core

/*
 * LightSweep3D - a sun's light through the box in one sweep: parallel lines along the light's travel, one
 * thread a line, each stepping one light cell a step along the axis the light mostly travels (the sweep
 * axis) and sliding across the other two by the light's slope. Each line carries the optical depth from
 * the entry layer's plane, the density's amount × uSigma inside the box (read where the line passes) and
 * the water's uFog all the way (the water goes on past the box's sides, so light entering a side has come
 * down as far). At each layer a cell's light is the bilinear mix of the four lines around its middle, so
 * the light is that of straight lines at every cell: a line written to the cell it passes instead
 * steps sideways every few rows, and the steps show as stripes across the lit density.
 *
 * A workgroup holds 8 × 8 lines, their transmittances shared each layer; it writes the 7 × 7 cells its
 * lines surround, and the workgroups overlap by one line, so every cell is written once. One density
 * read a line a layer, where a march from every cell toward the sun reads its whole way.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler3D uDensity;     // RGBA16F: color × amount, the amount as alpha
layout(rgba16f, binding = 0) writeonly uniform image3D uLight;

uniform ivec3 uSize;          // the light grid's cells
uniform int   uAxis;          // the sweep axis: 0 x, 1 y, 2 z
uniform int   uDirection;     // +1: the light travels toward higher cells along the sweep axis, -1 lower
uniform vec2  uSlope;         // cells slid across (the other two axes, in order) per cell along the sweep axis
uniform ivec2 uLineStart;     // the first line across, before the first cell where the light slides in from a side
uniform vec3  uSigma;         // the density's extinction per cell per unit of amount, per channel
uniform vec3  uFog;           // the water's extinction per cell, per channel
uniform float uStepCells;     // a step's length along the line, in cells

shared vec3 lines[8][8];      // this layer's transmittance on each of the workgroup's lines

ivec3 to_grid(int along, ivec2 across) {
    if (uAxis == 0) return ivec3(along, across.x, across.y);
    if (uAxis == 1) return ivec3(across.x, along, across.y);
    return ivec3(across.x, across.y, along);
}

vec3 to_grid(float along, vec2 across) {
    if (uAxis == 0) return vec3(along, across.x, across.y);
    if (uAxis == 1) return vec3(across.x, along, across.y);
    return vec3(across.x, across.y, along);
}

void main() {
    int n_along = uAxis == 0 ? uSize.x : (uAxis == 1 ? uSize.y : uSize.z);
    ivec2 n_across = uAxis == 0 ? uSize.yz : (uAxis == 1 ? uSize.xz : uSize.xy);
    ivec2 local = ivec2(gl_LocalInvocationID.xy);
    ivec2 line = ivec2(gl_WorkGroupID.xy) * 7 + local + uLineStart;    // overlapping by one line
    vec3 size = vec3(uSize);

    vec3 depth = vec3(0.0);                     // the optical depth so far, per channel
    for (int k = 0; k < n_along; k++) {
        int along = uDirection > 0 ? k : n_along - 1 - k;
        vec2 slid = uSlope * float(k);
        vec2 here = vec2(line) + 0.5 + slid;    // where the line passes, in cells across
        vec3 half_step = 0.5 * uStepCells * uFog;
        if (all(greaterThanEqual(here, vec2(0.0))) && all(lessThan(here, vec2(n_across)))) {
            float amount = max(texture(uDensity, to_grid(float(along) + 0.5, here) / size).a, 0.0);
            half_step += 0.5 * uStepCells * uSigma * amount;
        }
        lines[local.x][local.y] = exp(-(depth + half_step));
        depth += 2.0 * half_step;
        barrier();

        // the cell whose middle this line and the next ones surround, and how far past this line it lies
        vec2 up = ceil(slid);
        vec2 w = up - slid;
        ivec2 cell = line + ivec2(up);
        if (all(lessThan(local, ivec2(7))) && all(greaterThanEqual(cell, ivec2(0))) && all(lessThan(cell, n_across))) {
            vec3 low = mix(lines[local.x][local.y], lines[local.x + 1][local.y], w.x);
            vec3 high = mix(lines[local.x][local.y + 1], lines[local.x + 1][local.y + 1], w.x);
            imageStore(uLight, to_grid(along, cell), vec4(mix(low, high, w.y), 0.0));
        }
        barrier();
    }
}
