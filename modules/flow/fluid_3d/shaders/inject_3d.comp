#version 460 core

/*
 * Inject3D - a 2D input into a 3D volume at a target depth layer, in the gaussian slab around uTargetLayer:
 * weight = exp(-0.5 * ((z_norm - target) / spread)²) × uStrength. By uMode:
 *   0 ADD     the input × weight added
 *   1 RATE    the same, the field capped at its full value: a density's alpha at 1 (its color scaled with it),
 *             a scalar (uScalar) at ±1
 *   2 FILL    the field dragged toward the input times uGain (capped at full) by weight, never past it: a density only where the input's
 *             alpha is above the field's, a scalar only where the input is not 0, so where the body is not
 *             nothing is pulled toward 0
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;     // a brick of cells, so z neighbors share the cache

// 2D input texture
layout(binding = 0) uniform sampler2D uInput;     // 2D source (any format)

// 3D output volume
layout(rgba16f, binding = 0) uniform image3D uVolume;  // Read-write

// Parameters
uniform float uTargetLayer;  // Normalized depth [0, 1] — center of injection
uniform float uSpread;       // Gaussian sigma in normalized depth units
uniform float uStrength;     // Injection strength multiplier: × dt for ADD and RATE, the drag's share for FILL
uniform int   uMode;         // 0 ADD, 1 RATE, 2 FILL
uniform float uGain;         // FILL: the input times this, at most full, is the target
uniform bool  uScalar;       // a signed scalar in r (the temperature), else a premultiplied density
uniform ivec3 uSize;

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(gid, uSize))) return;

    // Normalized Z position of this voxel
    float z_norm = (float(gid.z) + 0.5) / float(uSize.z);

    // Remap uTargetLayer [0,1] to texel-center space:
    // 0.0 -> center of first layer, 1.0 -> center of last layer
    float target = (0.5 + uTargetLayer * (float(uSize.z) - 1.0)) / float(uSize.z);

    // Gaussian weight along depth
    float dz = (z_norm - target) / max(uSpread, 0.001);
    float weight = exp(-0.5 * dz * dz) * uStrength;

    if (weight < 0.001) return;  // Skip negligible contributions

    // Sample 2D input at this XY position
    vec2 uv = (vec2(gid.xy) + 0.5) / vec2(uSize.xy);
    vec4 source = texture(uInput, uv);
    // Nothing to add or fill where the image is empty (most of it): the texel stays as it is, unread and unwritten
    if (all(equal(source, vec4(0.0)))) return;
    vec4 current = imageLoad(uVolume, gid);
    if (uMode == 2) {
        if (uScalar) {
            source.r = clamp(source.r * uGain, -1.0, 1.0);
        } else if (source.a > 0.0) {
            source *= min(source.a * uGain, 1.0) / source.a;     // the presence times the gain, the color kept
        }
        bool fills = uScalar ? source.r != 0.0 : source.a > current.a;
        if (fills) current += (source - current) * min(weight, 1.0);
    } else {
        current += source * weight;
        if (uMode == 1) {
            if (uScalar) current.r = clamp(current.r, -1.0, 1.0);
            else if (current.a > 1.0) current /= current.a;
        }
    }
    imageStore(uVolume, gid, current);
}
