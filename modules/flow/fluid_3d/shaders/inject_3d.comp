#version 460 core

/*
 * Inject3D - a 2D scalar input (red, signed) into a 3D volume, in the gaussian slab around each pixel's z
 * position (nothing without one): weight = the body's share of the cell (slab.glsl) × uStrength. One invocation a
 * column: the input and its z position read once, then the cells the slab reaches. By uMode:
 *   0 ADD     the input × weight added
 *   1 FILL    the field dragged toward the input times uGain (capped at ±1), never past it: up by weight, down
 *             by the body's share × uRelease; only where the input is not 0, so where the body is not nothing
 *             is pulled toward 0
 * The density goes in by InjectDensity3D.
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;   // a column of cells each

layout(binding = 0) uniform sampler2D uInput;     // the scalar, red
layout(binding = 1) uniform sampler2D uZPosition; // its z position, red over green

layout(rgba16f, binding = 0) uniform image3D uVolume;  // Read-write

uniform bool  uHasZPosition;
uniform float uSpread;       // Gaussian sigma in normalized depth units
uniform float uStrength;     // Injection strength multiplier: × dt for ADD, the drag's share for FILL
uniform float uRelease;      // FILL: the share where the target is below the field; 0 = never down
uniform int   uMode;         // 0 ADD, 1 FILL
uniform float uGain;         // FILL: the input times this, at most ±1, is the target
uniform ivec3 uSize;

#include "slab.glsl"

void main() {
    ivec2 column = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(column, uSize.xy))) return;

    vec2 uv = (vec2(column) + 0.5) / vec2(uSize.xy);
    float source = texture(uInput, uv).r;
    // Nothing to add or fill where the input is 0 (most of it): the column stays as it is, unread and unwritten
    if (source == 0.0) return;
    if (uMode == 1) source = clamp(source * uGain, -1.0, 1.0);

    float center = slab_center(uv);
    if (center == NO_Z_POSITION) return;
    ivec2 cells = slab_cells(center, uSize.z);
    for (int z = cells.x; z <= cells.y; z++) {
        // The body's share of this cell's depth (slab.glsl)
        float slab = slab_cell(z, center, uSize.z);
        float weight = slab * uStrength;
        float release = slab * uRelease;
        if (max(weight, uMode == 1 ? release : 0.0) < 0.001) continue;  // Skip negligible contributions
        ivec3 gid = ivec3(column, z);
        float current = imageLoad(uVolume, gid).r;
        if (uMode == 1) {
            float share = source > current ? weight : release;
            if (share < 0.001) continue;
            current += (source - current) * min(share, 1.0);
        } else {
            current += source * weight;
        }
        imageStore(uVolume, gid, vec4(current, 0.0, 0.0, 0.0));
    }
}
