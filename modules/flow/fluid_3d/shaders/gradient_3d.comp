#version 460 core

/*
 * Gradient3D - the pressure's gradient subtracted from the velocity on the cells' faces (faces.glsl): each
 * face less its two cells' pressure difference over h,
 *
 *   u(i) -= (p(i) - p(i - 1)) / h
 *
 * A face on a closed wall or an obstacle's stays 0. On an open wall the cell beyond is the ghost, -p
 * (walls.glsl), so the pressure is 0 on the wall's face and the face is set by it: the water leaves.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;     // a brick of cells, so z neighbors share the cache

layout(binding = 0) uniform sampler3D uPressure;   // R32F at the cells
layout(binding = 2) uniform sampler3D uObstacle;   // R8 at the cells

uniform ivec3 uCells;
uniform ivec3 uClosed;
uniform bool  uHasObstacles;

#include "walls.glsl"
#include "faces.glsl"

void main() {
    ivec3 i = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThan(i, uCells))) return;
    vec3 v = vec3(0.0);
    for (int c = 0; c < 3; c++) {
        if (!is_face(c, i) || held_face(c, i)) continue;
        ivec3 left = i;
        left[c] -= 1;
        bool right_beyond = i[c] == uCells[c];      // the face on the far wall: its right cell the ghost
        bool left_beyond = i[c] == 0;               // on the near wall: its left cell the ghost
        float p_right = right_beyond ? 0.0 : texelFetch(uPressure, i, 0).r;
        float p_left = left_beyond ? 0.0 : texelFetch(uPressure, left, 0).r;
        if (right_beyond) p_right = wall_pressure(p_left, c);
        if (left_beyond) p_left = wall_pressure(p_right, c);
        v[c] = face_fetch(c, i) - (p_right - p_left) / uCell[c];
    }
    store_faces(i, v);
}
