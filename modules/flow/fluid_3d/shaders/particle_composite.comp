#version 460 core

/*
 * ParticleComposite - the particles' depth slices marched front to back into the 2D output, as
 * Composite3D marches the grid: per slice, per-channel Beer-Lambert extinction (near ink covers far
 * ink), the water's tint and fog. A slice holds the sum of the grid's
 * layers it spans, so its extinction is theirs. One slice is the additive look: its fog and tint
 * were given per particle, so uFog is 0 then.
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2DArray uSlices;  // RGBA16F: rgb × value, value

layout(rgba16f, binding = 0) writeonly uniform image2D uOutput;

uniform int   uDepth;        // The slices marched
uniform ivec2 uOutputSize;
uniform float uEmission;
uniform float uAbsorption;
uniform float uTint;
uniform float uFog;

const vec3 WATER_CHAN = vec3(1.8, 1.0, 0.6);

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gid, uOutputSize))) return;

    vec3 chan  = mix(vec3(1.0), WATER_CHAN, uTint);
    vec3 sigma = uAbsorption * chan;
    vec3 fog_s = (uFog / float(max(uDepth, 1))) * chan;

    vec3 T   = vec3(1.0);
    vec3 vol = vec3(0.0);
    for (int i = 0; i < uDepth; i++) {
        vec4 s = texelFetch(uSlices, ivec3(gid, i), 0);
        vec3 e = uEmission * max(s.rgb, vec3(0.0));
        vol += T * e;
        float d = max(s.r, max(s.g, s.b));
        T *= exp(-(sigma * d + fog_s));
        if (all(lessThan(T, vec3(0.004)))) break;     // fully occluded
    }

    vec3 rgb = vol;
    float alpha = 1.0 - dot(T, vec3(0.299, 0.587, 0.114));
    imageStore(uOutput, gid, vec4(rgb, alpha));
}
