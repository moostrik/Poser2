#version 460 core

/*
 * MacCormack3D - the MacCormack correction of a semi-Lagrangian advection (Selle et al. 2008).
 *
 * The predictor (uForward) is the semi-Lagrangian step of the source, traced back along the
 * velocity. Traced forward again from each cell, the predictor gives back the source up to the
 * step's error; half of that error is added back:
 *
 *     phi = forward(x) + 0.5 * (source(x) - forward(x + dt * v(x)))
 *
 * and bounded by the source's eight texels around the backward trace: where it leaves them, the
 * predictor stands (Selle's revert), so the correction never makes a value the step could not have
 * read (no overshoot, no ringing) and never keeps energy the step lost; or, with uClamp (a density's
 * choice), the corrected value is cut to them, so neighbors never flip between sharp and soft. uBlend
 * mixes that share of the predictor in. Then the dissipation and
 * the evaporation, as the plain step applies them. The velocity and the obstacle are sampled by
 * uv, so the field may sit on a finer grid than they do.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;     // a brick of cells, so z neighbors share the cache

layout(binding = 0) uniform sampler3D uVelocity;  // Velocity field (RGBA16F: xyz = u,v,w)
layout(binding = 1) uniform sampler3D uSource;    // The field before the step
layout(binding = 2) uniform sampler3D uForward;   // The semi-Lagrangian predictor
layout(binding = 3) uniform sampler3D uObstacle;  // Obstacle mask (R8)

layout(rgba16f, binding = 0) writeonly uniform image3D uResult;

uniform float uTimestep;      // dt * speed
uniform vec3  uRdx;           // (1, width/height, 1/z_extent): the uv a width of each axis crosses
uniform float uDissipation;   // Exponential decay multiplier
uniform float uEvaporation;   // Subtracted this step; 0 for a signed field
uniform int   uMeasure;       // how the evaporation reads a field's size: 0 its alpha, 1 its vector's length, 2 |r|
uniform ivec3 uSize;          // Volume dimensions
uniform bool  uHasObstacles;
uniform int   uGuardSlot;     // The field's slot in the stage's FiniteGuard; -1 no guard
uniform ivec3 uClosed;        // Per axis, 1 where the domain's walls are closed
uniform bool  uFromFaces;     // the velocity read from its faces (faces.glsl, a field on the simulation's grid), else uVelocity
uniform ivec3 uCells;         // the simulation's cells, with uFromFaces
uniform bool  uClamp;         // where the correction overshoots: cut to the bounds, else revert to the predictor
uniform float uBlend;         // the predictor's share mixed into the result

#include "walls.glsl"
#include "faces.glsl"

// The stage's non-finite counts (FiniteGuard, GUARD_BINDING)
layout(std430, binding = 7) buffer FiniteGuard { uint uNonFinite[]; };

// The evaporation: the field's size taken down by uEvaporation, every channel scaled with it, so a
// color keeps its hue, a velocity its direction and a signed value its sign; its size the alpha of a
// premultiplied density (0), the length of a vector (1), or the first channel's magnitude (2)
vec4 evaporate(vec4 value) {
    float size = uMeasure == 0 ? value.a : (uMeasure == 1 ? length(value.xyz) : abs(value.r));
    if (size <= 0.0) return value;
    return value * (max(size - uEvaporation, 0.0) / size);
}

// The guard: a value whose exponent bits are all ones is an infinity or a NaN; it becomes 0 and is counted.
// A cell is counted once: where it held one (`held`, before the step reads it) or where the step made one
bool non_finite(vec4 value) {
    return any(equal(floatBitsToUint(value) & 0x7F800000u, uvec4(0x7F800000u)));
}

bool held(ivec3 gid) {
    if (uGuardSlot < 0 || !non_finite(texelFetch(uSource, gid, 0))) return false;
    atomicAdd(uNonFinite[uGuardSlot], 1u);
    imageStore(uResult, gid, vec4(0.0));
    return true;
}

vec4 guard(vec4 value) {
    if (uGuardSlot < 0 || !non_finite(value)) return value;
    atomicAdd(uNonFinite[uGuardSlot], 1u);
    return vec4(0.0);
}

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(gid, uSize))) return;
    if (held(gid)) return;      // a non-finite value held: 0, counted, not traced

    vec3 st = (vec3(gid) + 0.5) / vec3(uSize);
    vec4 forward = texelFetch(uForward, gid, 0);

    if (uHasObstacles && texture(uObstacle, st).r > 0.5) {
        imageStore(uResult, gid, texelFetch(uSource, gid, 0));
        return;
    }

    vec3 step = uTimestep * uRdx * (uFromFaces ? velocity_at(st * vec3(uCells)) : texture(uVelocity, st).xyz);
    vec3 st_back = st - step;
    vec4 back = texture(uForward, st + step);
    vec4 result = forward + 0.5 * (texelFetch(uSource, gid, 0) - back);

    // A trace that reads past a wall read the wall's value, which no texel holds: there the
    // correction has no source to be limited by, and kept it grows the velocity at the walls step
    // after step, so the predictor stands
    ivec3 base = ivec3(floor(st_back * vec3(uSize) - 0.5));
    if (any(lessThan(base, ivec3(0))) || any(greaterThan(base + 1, uSize - 1))) {
        result = forward;
    } else {
        // The limiter: the source's eight texels the backward trace read between
        vec4 lo = vec4(1e30);
        vec4 hi = vec4(-1e30);
        for (int k = 0; k < 8; k++) {
            vec4 value = texelFetch(uSource, base + ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1), 0);
            lo = min(lo, value);
            hi = max(hi, value);
        }
        // Out of those bounds the correction reverts to the predictor, the semi-Lagrangian step (Selle et al.
        // 2008's revert): a clamp would keep it at the bound, which holds energy the step lost, and with the
        // vorticity confinement adding more the water grew step after step (measured: the mean speed rose
        // after the body stopped at the textbook epsilon 0.3, where the revert decays as the plain step does)
        if (any(greaterThan(lo, hi))) {
            result = forward;                                   // no finite texel: no bounds
        } else if (uClamp) {
            result = clamp(result, lo, hi);
        } else {
            bool out_of_bounds = any(lessThan(result, lo)) || any(greaterThan(result, hi));
            result = out_of_bounds ? forward : result;
        }
    }
    result = mix(result, forward, uBlend);

    result *= uDissipation;
    if (uEvaporation > 0.0) {
        result = evaporate(result);
    }
    result = guard(result);
    imageStore(uResult, gid, result);
}
