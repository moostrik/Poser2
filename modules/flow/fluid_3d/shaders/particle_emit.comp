#version 460 core

/*
 * ParticleEmit - new particles from a density source, into the ring.
 *
 * Per texel of the color (premultiplied by its alpha, the coverage), its amount the bridge's (read by uv,
 * density_blend.glsl) times the color's alpha, fill's capped at 1: its expected
 * count this step is rate × dt × g, g = min(amount / floor, 1), rounded by a hash so faint density still
 * spawns now and then; each new particle takes amount × uStrength × slab / expected as its mass, so
 * the texel's mass is the grid's in expectation (slab: the gaussian's sum over the grid's layers)
 * and a strong drop makes heavy particles. Its color is the color's, straight, its place a random point in
 * the texel, its z drawn from the injection's gaussian around the texel's z position (none without one). The slots come from an atomic head, modulo
 * the count: a ring, the oldest overwritten.
 *
 * A particle: position (xyz in the volume's uv, w = packHalf2x16(mass, age)), previous (xyz,
 * w = packUnorm4x8(color)).
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct Particle { vec4 position; vec4 previous; };
layout(std430, binding = 0) buffer Particles { Particle particles[]; };
layout(std430, binding = 1) buffer Ring { uint head; };

layout(binding = 0) uniform sampler2D uColor;      // the color, premultiplied by its alpha
layout(binding = 1) uniform sampler2D uZPosition;   // the amount's z position, red over green
layout(binding = 2) uniform sampler2D uAmount;      // the amount, red

uniform float uStrength;    // the share of the amount added this step: over, fill, the drag's; add, dt; × the injection's weight
uniform float uDt;          // s
uniform float uRate;        // particles per texel per second where density is
uniform float uFloor;       // the amount below which a texel spawns fewer
uniform bool  uHasZPosition;
uniform int   uLayers;      // the grid's layers, which place the center and sum the slab
uniform float uSpread;      // its sigma
uniform uint  uCount;       // the ring's size
uniform uint  uSeed;        // the frame

const int MAX_PER_TEXEL = 16;

#include "density_blend.glsl"
#include "slab.glsl"

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float random(inout uint state) {
    state = hash(state);
    return float(state) / 4294967295.0;
}

void main() {
    ivec2 size = textureSize(uColor, 0);
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gid, size))) return;

    vec4 source = texelFetch(uColor, gid, 0);
    vec2 texel = (vec2(gid) + 0.5) / vec2(size);
    float amount = density_amount(texture(uAmount, texel).r) * source.a;
    if (uBlend == BLEND_FILL) amount = min(amount, 1.0);    // fill's target, at most fully dyed
    if (amount <= 0.0) return;
    float center = slab_center(texel);
    if (center == NO_Z_POSITION) return;        // no place in the depth: no particle

    uint state = hash(uint(gid.x) * 73856093u ^ uint(gid.y) * 19349663u ^ uSeed * 83492791u);
    float expected = uRate * uDt * min(amount / max(uFloor, 1e-6), 1.0);
    int n = int(floor(expected)) + (random(state) < fract(expected) ? 1 : 0);
    n = min(n, MAX_PER_TEXEL);
    if (n <= 0) return;

    float middle = slab_middle(center, uLayers);    // the slab's center in the volume's z, as the grid's layers place it
    float mass = amount * uStrength * slab_column(center, uLayers) / max(expected, 1e-6);
    vec3 color = clamp(source.rgb / source.a, 0.0, 1.0);
    float packed_color = uintBitsToFloat(packUnorm4x8(vec4(color, 1.0)));
    float packed_mass = uintBitsToFloat(packHalf2x16(vec2(mass, 0.0)));

    uint start = atomicAdd(head, uint(n));
    for (int i = 0; i < n; i++) {
        uint slot = (start + uint(i)) % uCount;
        vec2 uv = (vec2(gid) + vec2(random(state), random(state))) / vec2(size);
        // a gaussian z by Box-Muller
        float r = sqrt(-2.0 * log(max(random(state), 1e-7)));
        float z = clamp(middle + uSpread * r * cos(6.2831853 * random(state)), 0.0, 1.0);
        vec3 position = vec3(uv, z);
        particles[slot].position = vec4(position, packed_mass);
        particles[slot].previous = vec4(position, packed_color);
    }
}
