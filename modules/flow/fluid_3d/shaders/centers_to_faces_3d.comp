#version 460 core

/*
 * CentersToFaces3D - the velocity at the cells' centers put on their faces, each face the mean of its two
 * cells; on a closed wall or with an obstacle's cell on either side 0, on an open wall its one cell's.
 * The scaffold while passes of the step still read and write the centers.
 */

#pragma optionNV(unroll all)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(binding = 2) uniform sampler3D uObstacle;
layout(binding = 0) uniform sampler3D uCenters;      // RGBA16F at the cells

uniform ivec3 uCells;
uniform ivec3 uClosed;
uniform bool  uHasObstacles;

#include "walls.glsl"
#include "faces.glsl"

void main() {
    ivec3 i = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThan(i, uCells))) return;
    vec3 v = vec3(0.0);
    for (int c = 0; c < 3; c++) {
        if (!is_face(c, i) || held_face(c, i)) continue;
        ivec3 before = i;
        before[c] -= 1;
        ivec3 after = min(i, uCells - 1);
        before = max(before, ivec3(0));
        v[c] = 0.5 * (texelFetch(uCenters, before, 0)[c] + texelFetch(uCenters, after, 0)[c]);
    }
    store_faces(i, v);
}
