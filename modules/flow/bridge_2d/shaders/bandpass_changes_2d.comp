#version 460 core

// Bandpass Changes 2D
// The 2D bandpass's four parts in one dispatch, each its size (R16F) and its velocity (RG16F): fast - slow along
// the motion's direction (the fast trail's, the slow one's where the fast trail has stopped), its rise for a start
// and a bow, its fall for a stop and a wake, over the trails' step peak (uScale), so a limb at speed v that starts
// or stops at once reads v. Its region splits it in two by the region weight (0 = all of it is the region's): the
// share its region changes the same way is the start or the stop, the rest the bow or the wake. A rise reads the
// region's mean moving velocity through the fast and the slow trail, a fall the region's mean speeds (a mip level
// of fast in R, slow in G). A part's velocity is its size along its trail's direction: a start's and a bow's the
// fast trail's, a stop's and a wake's the slow trail's.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D uFast;           // the fast trail (xy)
layout(binding = 1) uniform sampler2D uSlow;           // the slow trail
layout(binding = 2) uniform sampler2D uRiseFast;       // a rise's region: its mean moving velocity through the fast trail, a texel per region
layout(binding = 3) uniform sampler2D uRiseSlow;       // and through the slow trail
layout(binding = 4) uniform sampler2D uFallSpeeds;     // a fall's region: mean speeds, fast R, slow G, with mipmaps
uniform float uScale;               // 1 / the trails' step peak; 0 = no changes
uniform float uRiseWeight;          // start_region_weight
uniform float uFallWeight;          // stop_region_weight
uniform float uFallLod;             // a fall's region's mip level
uniform ivec2 uSize;

layout(r16f, binding = 0) writeonly uniform image2D uStartSpeed;
layout(r16f, binding = 1) writeonly uniform image2D uBowSpeed;
layout(r16f, binding = 2) writeonly uniform image2D uStopSpeed;
layout(r16f, binding = 3) writeonly uniform image2D uWakeSpeed;
layout(rg16f, binding = 4) writeonly uniform image2D uStart;
layout(rg16f, binding = 5) writeonly uniform image2D uBow;
layout(rg16f, binding = 6) writeonly uniform image2D uStop;
layout(rg16f, binding = 7) writeonly uniform image2D uWake;

const float EPSILON = 1e-4;     // below this a speed is no motion

vec2 unit_of(vec2 v) {
    float l = length(v);
    return l > EPSILON ? v / l : vec2(0.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, uSize))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(uSize);

    vec2 fast = texture(uFast, uv).xy;
    vec2 slow = texture(uSlow, uv).xy;
    // A stopped fast trail has no direction left; the slow trail still holds it
    vec2 unit = length(fast) > EPSILON ? unit_of(fast) : unit_of(slow);
    float along = dot(fast - slow, unit) * uScale;
    float rise = max(0.0, along);
    float fall = max(0.0, -along);

    float rise_share = 1.0;
    if (uRiseWeight > 0.0) {
        float region_fast = length(texture(uRiseFast, uv).xy);
        float change = (region_fast - length(texture(uRiseSlow, uv).xy)) / max(region_fast, EPSILON);
        rise_share = mix(1.0, clamp(change, 0.0, 1.0), uRiseWeight);
    }
    float fall_share = 1.0;
    if (uFallWeight > 0.0) {
        vec2 region_speed = textureLod(uFallSpeeds, uv, uFallLod).rg;     // fast, slow
        float change = (region_speed.g - region_speed.r) / max(region_speed.g, EPSILON);
        fall_share = mix(1.0, clamp(change, 0.0, 1.0), uFallWeight);
    }

    float start = rise * rise_share;
    float bow = rise * (1.0 - rise_share);
    float stop = fall * fall_share;
    float wake = fall * (1.0 - fall_share);
    vec2 fast_unit = unit_of(fast);
    vec2 slow_unit = unit_of(slow);
    imageStore(uStartSpeed, pixel, vec4(start, 0.0, 0.0, 0.0));
    imageStore(uBowSpeed, pixel, vec4(bow, 0.0, 0.0, 0.0));
    imageStore(uStopSpeed, pixel, vec4(stop, 0.0, 0.0, 0.0));
    imageStore(uWakeSpeed, pixel, vec4(wake, 0.0, 0.0, 0.0));
    imageStore(uStart, pixel, vec4(fast_unit * start, 0.0, 0.0));
    imageStore(uBow, pixel, vec4(fast_unit * bow, 0.0, 0.0));
    imageStore(uStop, pixel, vec4(slow_unit * stop, 0.0, 0.0));
    imageStore(uWake, pixel, vec4(slow_unit * wake, 0.0, 0.0));
}
