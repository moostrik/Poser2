#version 460 core

// Histogram Count Shader
// Counts a texture's four channels into bins, on a grid of samples: one invocation per sample,
// one atomic add per channel. The bins run from -1 to 1 after `scale`; a value outside lands in
// the end bin.
// With `speed` the length of each sample's xyz instead, into the first row's bins on a log scale from
// `speed_low` to `speed_high`: a length below `speed_low` is still and not counted, one above `speed_high`
// lands in the end bin. The numpy reference is bridge_3d.speed_bin

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D tex0;     // The texture counted
uniform float scale;        // Multiplier on the values
uniform ivec2 samples;      // The grid of samples, across and down
uniform bool speed;         // Count the length of xyz on a log scale
uniform float speed_low;    // The first bin's lower edge
uniform float speed_high;   // The last bin's upper edge

layout(r32ui, binding = 0) uniform uimage2D histogram;     // bins wide, one row per channel

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, samples))) return;

    int bins = imageSize(histogram).x;
    vec2 uv = (vec2(id) + 0.5) / vec2(samples);
    vec4 value = textureLod(tex0, uv, 0.0) * scale;
    if (speed) {
        float length_ = length(value.xyz);
        if (!(length_ >= speed_low)) return;    // still, or not a number
        int bin = clamp(int(floor(log(length_ / speed_low) / log(speed_high / speed_low) * float(bins))), 0, bins - 1);
        imageAtomicAdd(histogram, ivec2(bin, 0), 1u);
        return;
    }
    for (int channel = 0; channel < 4; channel++) {
        int bin = clamp(int(floor((value[channel] * 0.5 + 0.5) * float(bins))), 0, bins - 1);
        imageAtomicAdd(histogram, ivec2(bin, channel), 1u);
    }
}
