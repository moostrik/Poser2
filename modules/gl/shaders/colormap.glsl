    vec3(0.6645, 0.0844, 0.0042), vec3(0.5710, 0.0447, 0.0053), vec3(0.4796, 0.0158, 0.0106)
);

const vec3 VIRIDIS[33] = vec3[33](
    vec3(0.2670, 0.0049, 0.3294), vec3(0.2770, 0.0503, 0.3757), vec3(0.2823, 0.0950, 0.4173),
