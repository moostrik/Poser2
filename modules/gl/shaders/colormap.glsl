    vec3(0.8456, 0.8873, 0.0997), vec3(0.9261, 0.8973, 0.1041), vec3(0.9932, 0.9062, 0.1439)
);

const int COLORMAP_TURBO = 0;
const int COLORMAP_VIRIDIS = 1;
const int COLORMAP_JET = 2;

vec3 jet(float t) {
    return clamp(1.5 - abs(4.0 * t - vec3(3.0, 2.0, 1.0)), 0.0, 1.0);
}

vec3 turbo(float t) {
    float x = clamp(t, 0.0, 1.0) * 32.0;
    int i = min(int(x), 31);
    return mix(TURBO[i], TURBO[i + 1], x - float(i));
}

vec3 viridis(float t) {
    float x = clamp(t, 0.0, 1.0) * 32.0;
    int i = min(int(x), 31);
    return mix(VIRIDIS[i], VIRIDIS[i + 1], x - float(i));
}

vec3 colormap(int map, float t) {
    if (map == COLORMAP_TURBO) return turbo(t);
    if (map == COLORMAP_VIRIDIS) return viridis(t);
    return jet(t);
}
